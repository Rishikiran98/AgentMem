# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# Raw benchmark outputs are large and immutable; they are archived outside git.
results/raw/*
!results/raw/.gitkeep

# Local secrets
.env

# Benchmark datasets are downloaded, hashed, and never committed.
data/*
!data/.gitkeep
# Local system state (Mem0 history DB, embedded stores)
results/state/
.venv-letta/
openapi_letta.json
